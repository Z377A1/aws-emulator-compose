# Copy to .env and adjust.

# x86_64 (Intel/AMD) or aarch64 (Apple silicon / Arm)
EMULATOR_ARCH=x86_64

# Used on both sides of the port mapping and as the emulator's -p option.
EMULATOR_PORT=9297

# Host directory shared with the container (must exist before `up` on Linux).
# Windows example: C:/Users/<you>/.aws/emulator
EMULATOR_DIR=~/.aws/emulator

# Set to "off" to disable usage/error telemetry. Or "on" to enable it.
EMULATOR_TELEMETRY=off

# Linux: set to the output of `id -u` / `id -g` so files belong to you.
UID=1000
GID=1000

# Shared Caddy (compose.caddy.yaml): https/http://aws-emulator-<EMULATOR_PORT>.localhost
# Host ports; change them if 443/80 are taken (URLs then carry the port).
CADDY_HTTPS_PORT=443
CADDY_HTTP_PORT=80
CADDY_VERSION=2.11.9
CADDY_DOCKER_CPU_LIMIT=1
CADDY_DOCKER_MEMORY_LIMIT=512M
